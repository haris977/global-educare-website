generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  password              String
  name                  String
  phone                 String?
  role                  Role                  @default(USER)
  profilePicture        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  subscriptionStatus    SubscriptionStatus?   @default(INACTIVE)
  subscriptionPlan      SubscriptionPlan?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  freeTrialUsed         Boolean               @default(false)
  refundRequested       Boolean               @default(false)
  refundStatus          RefundStatus?         @default(NONE)
  refundRequestDate     DateTime?
  refundProcessedDate   DateTime?
  lastLoginAt           DateTime?
  progressData          Json?
  practiceTests         PracticeTest[]
  responses             Response[]
  testAttempts          TestAttempt[]
  userScores            UserScore[]
  institutions          UsersOnInstitutions[]
}

model Test {
  id             String         @id @default(uuid())
  title          String
  description    String?
  difficulty     TestDifficulty @default(MEDIUM)
  moduleType     ModuleType
  totalTime      Int
  totalQuestions Int
  isPublished    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isFeatured     Boolean        @default(false)
  testCategory   String?
  clbScore       Int            @default(1)
  sections       Section[]
  attempts       TestAttempt[]
}

model Section {
  id           String     @id @default(uuid())
  testId       String
  title        String
  instructions String?
  order        Int
  timeLimit    Int?
  questions    Question[]
  test         Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Question {
  id                String       @id @default(uuid())
  sectionId         String
  questionText      String
  questionType      QuestionType
  questionImage     String?
  audioFile         String?
  additionalInfo    String?
  order             Int
  marks             Float        @default(1.0)
  options           Json?
  correctAnswer     String?
  bandDescriptors   Json?
  cueCard           String?
  passage           String?

  summaryWords        Json?
  summaryBlankAnswers Json?
  fillBlankSentence   String?
  completeSentenceAnswers Json? 

  headings            Json?      // For PARA_HEADINGS
  correctHeadings     Json?      // For PARA_HEADINGS
  fillBlankAnswers    Json?      // For FILL_BLANK
  sentenceBeginnings  Json?      // For SENTENCE_ENDINGS_MATCHING
  sentenceEndings     Json?      // For SENTENCE_ENDINGS_MATCHING
  correctEndings      Json?      // For SENTENCE_ENDINGS_MATCHING
  diagramImage        String?    // For DIAGRAM_LABELLING
  diagramAnswers      Json?      // For DIAGRAM_LABELLING
  wordLimit           String? 
  sampleAnswer      String?
  speakingPrompts   Json?
  paragraphs        Json?
  sentences         Json?
  csentences        Json?
  followUpQuestions String?
  matchingPairs     String?
  mapLabels         String?
  section           Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses         Response[]
}

model TestAttempt {
  id             String        @id @default(uuid())
  userId         String
  testId         String
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  lastSavedAt    DateTime      @default(now())
  totalScore     Float?
  status         AttemptStatus @default(IN_PROGRESS)
  currentSection Int           @default(0)
  timeRemaining  Int?
  responses      Response[]
  test           Test          @relation(fields: [testId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
}

model Response {
  id             String       @id @default(uuid())
  userId         String
  testAttemptId  String
  questionId     String
  userAnswer     String?
  audioRecording String?
  isCorrect      Boolean?
  marksAwarded   Float?
  feedback       String?
  reviewStatus   ReviewStatus @default(PENDING)
  submittedAt    DateTime     @default(now())
  question       Question     @relation(fields: [questionId], references: [id])
  testAttempt    TestAttempt  @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
}

model PracticeTest {
  id          String    @id @default(uuid())
  userId      String
  testType    TestType
  testScore   Float?
  completedAt DateTime?
  startedAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model UserScore {
  id         String     @id @default(uuid())
  userId     String
  moduleType ModuleType
  score      Float
  recordedAt DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id])
}

model Institution {
  id          String                @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  users       UsersOnInstitutions[]
}

model UsersOnInstitutions {
  userId        String
  institutionId String
  assignedAt    DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@id([userId, institutionId])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  STUDY_MATERIAL_ADMIN
  DOUBTS_SOLVING_ADMIN
  KEY_ACCOUNT_ADMIN
  TECHNICAL_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
  EXPIRED
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum RefundStatus {
  NONE
  REQUESTED
  PROCESSING
  APPROVED
  REJECTED
}

enum TestType {
  LISTENING
  READING
  WRITING
  SPEAKING
  FULL
}

enum ModuleType {
  LISTENING
  READING
  WRITING
  SPEAKING
  IELTS_GENERAL
  IELTS_ACADEMIC
  COMBINED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  ESSAY
  MATCHING
  GAP_FILLING
  NOTE_COMPLETION
  FLOW_CHART
  TABLE_COMPLETION
  DIAGRAM_LABELLING
  SUMMARY_COMPLETION
  SENTENCE_COMPLETION
  MAP_LABELLING
  PROCESS_DIAGRAM
  YES_NO_NOT_GIVEN
  TRUE_FALSE_NOT_GIVEN
  HEADING_MATCHING
  INFORMATION_MATCHING
  FEATURES_MATCHING
  SPEAKING_TASK_1
  SPEAKING_TASK_2
  SPEAKING_TASK_3
  PARA_HEADINGS
  COMPLETE_SENTENCE
  NAME_MATCHING
  MAP
  SPEAKING_FOLLOW_UPS
  SUMMARY
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
  EVALUATED
}

enum ReviewStatus {
  PENDING
  REVIEWED
  SKIPPED
}

enum TestDifficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}
