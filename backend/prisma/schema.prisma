generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with roles based on the PRD
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  name              String
  phone             String?
  role              Role      @default(USER)
  profilePicture    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Subscription related fields
  subscriptionStatus SubscriptionStatus? @default(INACTIVE)
  subscriptionPlan   SubscriptionPlan?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  freeTrialUsed        Boolean   @default(false)
  refundRequested      Boolean   @default(false)
  refundStatus         RefundStatus? @default(NONE)
  refundRequestDate    DateTime?
  refundProcessedDate  DateTime?

  // User activity tracking
  lastLoginAt        DateTime?
  progressData       Json? // Stores user progress data in JSON format
  
  // Practice tests and content engagement
  practiceTests      PracticeTest[]
  userScores         UserScore[]
  testAttempts       TestAttempt[]
  responses          Response[]
  
  // Many-to-many relationship with institutions
  institutions       UsersOnInstitutions[]
}

// Enhanced Test Models for IELTS
model Test {
  id              String    @id @default(uuid())
  title           String
  description     String?
  difficulty      TestDifficulty @default(MEDIUM)
  moduleType      ModuleType
  totalTime       Int       // In minutes
  totalQuestions  Int
  totalMarks      Float
  isPublished     Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  testCategory    String?   // For categorizing tests (e.g., "Practice", "Mock", "Official")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Content sections
  sections        Section[]
  
  // User attempts
  attempts        TestAttempt[]
}

model Section {
  id              String    @id @default(uuid())
  testId          String
  title           String
  instructions    String?
  order           Int
  timeLimit       Int?      // In minutes, null for unlimited
  
  // Relationship
  test            Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  
  // Questions in this section
  questions       Question[]
}

model Question {
  id                String    @id @default(uuid())
  sectionId         String
  questionText      String
  questionType      QuestionType
  questionImage     String?   // URL to image if applicable
  audioFile         String?   // URL to audio file for listening questions
  additionalInfo    String?   // Additional text, instructions, etc.
  order             Int
  marks             Float     @default(1.0)
  
  // Specific content based on question type
  options           Json?     // For MCQ, matching, etc.
  correctAnswer     String?   // For text input, essay questions will be null (manual review)
  
  // Reading specific fields
  passage           String?   // For reading passages
  paragraphs        String?   // For paragraph headings
  sentences         String?   // For complete the sentence and fill in the blanks
  matchingPairs     String?   // For name matching
  
  // Listening specific fields
  mapLabels         String?   // For map questions
  
  // Speaking specific fields
  cueCard           String?   // For speaking task 2
  speakingPrompts   Json?     // For speaking tasks
  followUpQuestions String?   // For speaking follow-ups
  
  // Assessment fields
  bandDescriptors   Json?     // Assessment criteria for writing/speaking
  sampleAnswer      String?   // Sample answer for writing/speaking tasks
  
  // Relationship
  section           Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  // User responses
  responses         Response[]
}

// User attempt at a test
model TestAttempt {
  id              String    @id @default(uuid())
  userId          String
  testId          String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  lastSavedAt     DateTime  @default(now())
  totalScore      Float?
  status          AttemptStatus @default(IN_PROGRESS)
  currentSection  Int       @default(0) // Tracks which section user is on
  timeRemaining   Int?      // Remaining time in seconds
  
  // Relationships
  user            User      @relation(fields: [userId], references: [id])
  test            Test      @relation(fields: [testId], references: [id])
  
  // User responses for this attempt
  responses       Response[]
}

// User response to a question
model Response {
  id              String    @id @default(uuid())
  userId          String
  testAttemptId   String
  questionId      String
  userAnswer      String?
  audioRecording  String?   // For speaking questions
  isCorrect       Boolean?
  marksAwarded    Float?
  feedback        String?
  reviewStatus    ReviewStatus @default(PENDING)
  submittedAt     DateTime  @default(now())
  
  // Relationships
  user            User      @relation(fields: [userId], references: [id])
  testAttempt     TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id])
}

// Original models
model PracticeTest {
  id          String    @id @default(uuid())
  userId      String
  testType    TestType
  testScore   Float?
  completedAt DateTime?
  startedAt   DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id])
}

model UserScore {
  id          String    @id @default(uuid())
  userId      String
  moduleType  ModuleType
  score       Float
  recordedAt  DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id])
}

model Institution {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Many-to-many relationship with users
  users       UsersOnInstitutions[]
}

// Join table for many-to-many relationship between User and Institution
model UsersOnInstitutions {
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String
  assignedAt    DateTime    @default(now())

  @@id([userId, institutionId])
}

// Original enums
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  STUDY_MATERIAL_ADMIN
  DOUBTS_SOLVING_ADMIN
  KEY_ACCOUNT_ADMIN
  TECHNICAL_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
  EXPIRED
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum RefundStatus {
  NONE
  REQUESTED
  PROCESSING
  APPROVED
  REJECTED
}

enum TestType {
  LISTENING
  READING
  WRITING
  SPEAKING
  FULL
}

enum ModuleType {
  LISTENING
  READING
  WRITING
  SPEAKING
  IELTS_GENERAL
  IELTS_ACADEMIC
  COMBINED
}

// New enums for enhanced test functionality
enum QuestionType {
  // Reading Question Types
  MULTIPLE_CHOICE
  PARA_HEADINGS
  COMPLETE_SENTENCE
  NAME_MATCHING
  FILL_BLANK
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  
  // Listening Question Types
  TRUE_FALSE
  MAP
  
  // Speaking Question Types
  SPEAKING_TASK_1      // Introduction
  SPEAKING_TASK_2      // Cue Card
  SPEAKING_TASK_3      // Discussion
  SPEAKING_FOLLOW_UPS  // Follow Up Questions
  
  // Other Question Types
  SHORT_ANSWER
  ESSAY
  MATCHING
  GAP_FILLING
  NOTE_COMPLETION
  FLOW_CHART
  TABLE_COMPLETION
  DIAGRAM_LABELLING
  SUMMARY_COMPLETION
  SENTENCE_COMPLETION
  MAP_LABELLING
  PROCESS_DIAGRAM
  HEADING_MATCHING
  INFORMATION_MATCHING
  FEATURES_MATCHING
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
  EVALUATED
}

enum ReviewStatus {
  PENDING
  REVIEWED
  SKIPPED
}

enum TestDifficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
} 